# On a fresh checkout, run python3 scripts/bootstrap-local.py first.
# It creates .env with unique database credentials and provisions local accounts.
# Append any settings you need below to that generated file.

# Optional AI extraction. Leave the API keys empty for the standard demo.
RENALSAFE_EXTRACTION_PROVIDER=openai
OPENAI_API_KEY=
RENALSAFE_OPENAI_MODEL=gpt-5.4-mini

# To use NVIDIA, set RENALSAFE_EXTRACTION_PROVIDER=nvidia and fill in its key.
NVIDIA_API_KEY=
RENALSAFE_NVIDIA_MODEL=moonshotai/kimi-k3.1-pro

# Set to true for quick sign-in when running an isolated local demonstration.
RENALSAFE_DEMO_LOGIN=false
